;;; b1.lsp - generated from Template1.svg
;;; Creates native DraftSight LINE/TEXT entities. No SVG import dialog.

(defun _tpl-line (p1 p2 space)
  (entmakex
    (list
      (cons 0 "LINE")
      (cons 67 space)
      (cons 10 (list (car p1) (cadr p1) 0.0))
      (cons 11 (list (car p2) (cadr p2) 0.0))
    )
  )
)

(defun _tpl-text (pt h s space)
  (entmakex
    (list
      (cons 0 "TEXT")
      (cons 67 space)
      (cons 10 (list (car pt) (cadr pt) 0.0))
      (cons 40 h)
      (cons 1 s)
      (cons 50 0.0)
    )
  )
)

